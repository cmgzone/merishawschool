# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (SQLite for dev; switch to Postgres URL in prod)
DATABASE_URL="file:./dev.db"

# Mailcow
# Base URL of your mailcow instance (no trailing slash).
MAILCOW_API_URL=https://mail.merishawschools.sc.ke
# API key from mailcow Configuration > Access > API
MAILCOW_API_KEY=

# Default IMAP/SMTP host advertised to clients (usually the mailcow host)
DEFAULT_IMAP_HOST=mail.merishawschools.sc.ke
DEFAULT_IMAP_PORT=993
DEFAULT_SMTP_HOST=mail.merishawschools.sc.ke
DEFAULT_SMTP_PORT=587

# Restrict app signups/logins to Merishaw mailboxes. Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAIN=merishawschools.sc.ke

# CORS origins (comma separated)
CORS_ORIGIN=*
