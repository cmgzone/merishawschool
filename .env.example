ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=generate-with-node-scripts-hash-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
# Keep false unless the app is reachable only through a trusted proxy that
# overwrites client IP headers.
ADMIN_TRUST_PROXY_HEADERS=false

# Local/dev fallback only. Prefer ADMIN_PASSWORD_HASH for production.
# ADMIN_PASSWORD=replace-with-a-strong-password

# Tawk.to live chat widget (https://www.tawk.to)
# Find this in: Administration > Channels > Chat Widget > embed URL
NEXT_PUBLIC_TAWK_EMBED_URL=

# Legacy fallback if you prefer splitting the embed URL manually.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# SMTP email for contact form submissions.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL_TO=enquiries@merishawschools.sc.ke

# Set to true only if the SMTP provider allows website auto-replies safely.
CONTACT_SEND_CONFIRMATION=false
