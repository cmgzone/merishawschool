ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-node-scripts-hash-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Local/dev fallback only. Prefer ADMIN_PASSWORD_HASH for production.
# ADMIN_PASSWORD=replace-with-a-strong-password

# Tawk.to live chat widget (https://www.tawk.to)
# Find these in: Administration → Channels → Chat Widget → embed URL
# URL format: https://embed.tawk.to/PROPERTY_ID/WIDGET_ID
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
